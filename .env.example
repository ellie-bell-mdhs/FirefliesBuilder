# Copy to .env and fill in. .env is gitignored.

# --- Claude Code session ---
# Each meeting opens a Ghostty window running the `claude` CLI, which uses your
# LOCAL Claude Code login (your `claude` subscription), NOT the Anthropic API.
# Make sure you're logged in: run `claude` once and sign in. No API key needed.

# --- Fireflies (GraphQL API) ---
# Fireflies dashboard -> Settings -> Developer Settings -> API Key
FIREFLIES_API_KEY=
FIREFLIES_API_URL=https://api.fireflies.ai/graphql

# --- Behavior tuning ---
# Which model the meeting's `claude` session uses (passed to `claude --model`).
BUILD_MODEL=claude-opus-4-8
# Where per-meeting folders are created (<date>-<slug>/ goes inside this).
BUILDS_DIR=/Users/ebell/Projects
# How often to check Fireflies for meetings that just went live, in seconds.
ACTIVE_POLL_SECONDS=30
# How often to refresh a live meeting's TRANSCRIPT.md, in seconds.
TRANSCRIPT_POLL_SECONDS=40

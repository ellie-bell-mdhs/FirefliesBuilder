# Copy to .env and fill in. .env is gitignored.

# --- Claude Code session ---
# Each meeting opens a Ghostty window running the `claude` CLI, which uses your
# LOCAL Claude Code login (your `claude` subscription), NOT the Anthropic API.
# Make sure you're logged in: run `claude` once and sign in. No API key needed.

# --- Fireflies (GraphQL API) ---
# Fireflies dashboard -> Settings -> Developer Settings -> API Key
FIREFLIES_API_KEY=
FIREFLIES_API_URL=https://api.fireflies.ai/graphql

# --- Behavior tuning ---
# Which model the orchestrator and every worker agent use (passed to `claude --model`).
BUILD_MODEL=claude-opus-4-8
# Where per-meeting folders are created (<date>-<slug>/ goes inside this).
BUILDS_DIR=/Users/ebell/Projects
# How often to check Fireflies for meetings that just went live, in seconds.
ACTIVE_POLL_SECONDS=30
# How often to refresh a live meeting's TRANSCRIPT.md, in seconds.
TRANSCRIPT_POLL_SECONDS=40

# --- Visual capture (screenshots) ---
# After a meeting, download the Fireflies recording and extract the exact video frame
# for each moment the agents flagged with `./mesh shot`. Needs ffmpeg on PATH, and a
# Fireflies Pro+ plan with "RECORD MEETING VIDEO" enabled (else video_url is null).
CAPTURE_ENABLED=true
# Also grab a live macOS screenshot when a moment is flagged (needs Screen Recording
# permission for the terminal). Set false to only queue the timestamp for later.
LIVE_SCREENSHOT=true
# How long to wait (and how often to poll) for Fireflies to finish processing the
# video after a meeting ends, before giving up.
VIDEO_WAIT_MAX_SECONDS=900
VIDEO_POLL_SECONDS=45
# Optional explicit ffmpeg path; otherwise resolved from common locations / PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

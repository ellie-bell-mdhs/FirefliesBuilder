# Copy to .env and fill in. .env is gitignored.

# --- Claude Agent SDK ---
# The build step runs your LOCAL Claude Code login (your `claude` subscription),
# NOT the Anthropic API. Make sure you're logged in: run `claude` once and sign in.
# Leave ANTHROPIC_API_KEY unset/blank — setting it would route to the paid API.

# --- Fireflies (GraphQL API) ---
# Fireflies dashboard -> Settings -> Developer Settings -> API Key
FIREFLIES_API_KEY=
FIREFLIES_API_URL=https://api.fireflies.ai/graphql

# --- Behavior tuning ---
# Which model the build agent uses.
BUILD_MODEL=claude-opus-4-8
# How often to check Fireflies for meetings that just went live, in seconds.
ACTIVE_POLL_SECONDS=30
# How often to poll a live meeting's transcript, in seconds.
TRANSCRIPT_POLL_SECONDS=40

# Copy to .env and fill in. .env is gitignored.

# --- Claude Agent SDK ---
# Used by @anthropic-ai/claude-agent-sdk for the "build" step.
ANTHROPIC_API_KEY=

# --- Fireflies (GraphQL API) ---
# Fireflies dashboard -> Settings -> Developer Settings -> API Key
FIREFLIES_API_KEY=
FIREFLIES_API_URL=https://api.fireflies.ai/graphql

# --- Microsoft Graph (Outlook calendar) --- [Phase 2]
# Azure Portal -> App registrations. Delegated permission: Calendars.Read
MS_CLIENT_ID=
MS_TENANT_ID=common
# Public-client (device-code / auth-code + PKCE) needs no secret; set if using a confidential client.
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Behavior tuning ---
# Which model the build agent uses.
BUILD_MODEL=claude-opus-4-8
# How often to poll the live transcript, in seconds.
TRANSCRIPT_POLL_SECONDS=40
# How often to poll the calendar, in seconds.
CALENDAR_POLL_SECONDS=60
# Fire the worker this many seconds before a meeting's start time.
LEAD_SECONDS=120

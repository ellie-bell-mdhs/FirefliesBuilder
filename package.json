{
  "name": "meeting-build-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Listens to your meetings via Fireflies and builds code/docs live with a Claude coding agent.",
  "type": "module",
  "scripts": {
    "replay": "tsx src/replay.ts",
    "typecheck": "tsc --noEmit",
    "watch": "tsx src/orchestrator.ts",
    "build": "tsc",
    "app": "npm run build && electron dist/main.js",
    "bundle:app": "npm run build && bash launcher/build.sh",
    "verify:fireflies": "tsx src/verify-fireflies.ts",
    "test:mesh": "tsx src/mesh/mesh.test.ts",
    "install:agent": "npm run build && node scripts/launchagent.mjs install",
    "uninstall:agent": "node scripts/launchagent.mjs uninstall"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^43.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}

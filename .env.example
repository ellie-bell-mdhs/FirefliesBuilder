# Copy to .env and fill in. .env is gitignored.

# --- Claude Agent SDK ---
# The build step runs your LOCAL Claude Code login (your `claude` subscription),
# NOT the Anthropic API. Make sure you're logged in: run `claude` once and sign in.
# Leave ANTHROPIC_API_KEY unset/blank — setting it would route to the paid API.

# --- Fireflies (GraphQL API) ---
# Fireflies dashboard -> Settings -> Developer Settings -> API Key
FIREFLIES_API_KEY=
FIREFLIES_API_URL=https://api.fireflies.ai/graphql

# --- Microsoft Graph (Outlook calendar) ---
# Azure Portal -> App registrations. Public client, delegated Calendars.Read.
# Used to launch ~2 min before a meeting; run `npm run login` once to connect.
MS_CLIENT_ID=
MS_TENANT_ID=common

# --- Behavior tuning ---
# Which model the build agent uses (runs on your local Claude Code login).
BUILD_MODEL=claude-opus-4-8
# Fire the menu bar + build this many seconds before a meeting starts.
LEAD_SECONDS=120
# How often to poll the Outlook calendar, in seconds.
CALENDAR_POLL_SECONDS=60
# How often to poll a live meeting's transcript, in seconds.
TRANSCRIPT_POLL_SECONDS=40
